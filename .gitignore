# Generated experiment data and artifacts. Keep experiment recipes (configs,
# scripts, plans, and reports) in source control; keep their outputs local.
/experiments/**/data/
/experiments/**/logs/
/experiments/**/results/
/experiments/**/eval/
/experiments/**/out/
/experiments/**/output/
/experiments/**/artifacts/
/experiments/**/*.csv
/experiments/**/*.json
/experiments/**/*.jsonl
/experiments/**/*.log
/experiments/**/*.out
/experiments/**/*.npy
/experiments/**/*.npz
/experiments/**/*.pt
/experiments/**/*.pth
/experiments/**/*.ckpt
/experiments/**/*.png

# Runtime workers and model artifacts are generated, including the active
# run-rl deck while it remains outside experiments.
/rundecks/**/bin/
